{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.fluid",
  "name": "pocket-shell-touch",
  "title": "Pocket Shell Touch",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "input.touch",
        "text.glyphs.baked"
      ]
    }
  },
  "app": {
    "entry": "src/main.tsx",
    "output": "pocketshell-touch",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          320,
          480
        ],
        "presentation": "native"
      }
    }
  }
}
